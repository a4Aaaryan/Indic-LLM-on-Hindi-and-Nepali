# Data directories (exclude actual data files, keep directory structure via .gitkeep)
hindi/data/raw/*
!hindi/data/raw/.gitkeep
hindi/data/interim/*
!hindi/data/interim/.gitkeep
hindi/data/cleaned/*
!hindi/data/cleaned/.gitkeep
hindi/data/splits/*
!hindi/data/splits/.gitkeep

nepali/data/raw/*
