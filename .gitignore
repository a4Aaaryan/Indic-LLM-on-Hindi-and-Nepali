# Large data formats anywhere in data/
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.bz2
*.xz
*.7z
*.jsonl
*.parquet
*.arrow
*.tsv
*.csv.gz

# Tokenizer binaries (if large)
hindi/tokenizer/models/*
!hindi/tokenizer/models/.gitkeep
hindi/tokenizer/vocab/*
!hindi/tokenizer/vocab/.gitkeep

nepali/tokenizer/models/*
!nepali/tokenizer/models/.gitkeep

nepali/tokenizer/vocab/*
